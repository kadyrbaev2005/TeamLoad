# Public URL of the app (invite links, Secure cookies when https).
APP_URL=http://localhost:8080
# Time zone used for "today" (deadlines, daily AI limit).
APP_TZ=Asia/Almaty
# Signs session cookies. Required when APP_URL is https.
JWT_SECRET=change-me-to-a-long-random-string

# AI provider: mock (default, no key needed) or gemini.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_CALLS_PER_PROJECT_PER_DAY=30
# Artificial delay of the mock provider so the loading overlay is visible.
MOCK_DELAY_MS=1500
